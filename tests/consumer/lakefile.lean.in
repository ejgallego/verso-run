import Lake
open Lake DSL

require verso_run from git {{source}} @ {{revision}}

package candidate_consumer

input_dir consumerWeb where
  path := "web"
  text := true

lean_lib ConsumerModel where
  srcDir := "models"
  roots := #[`Consumer.Model]

lean_lib ConsumerChapter where
  srcDir := "chapters"
  roots := #[`Consumer.Chapter, `Consumer.Blog, `Consumer.Slides]

lean_lib ConsumerPublication where
  roots := #[`Presenter]
  needs := #[consumerWeb]

lean_lib ConsumerResources where
  srcDir := "resources"
  roots := #[`Consumer.Resources, `Consumer.BlogResources, `Consumer.SlidesResources]
  needs := #[`+Consumer.Chapter:virResourcePack, `+Consumer.Blog:virResourcePack,
    `+Consumer.Slides:virResourcePack]

@[default_target]
lean_exe «consumer-manual» where
  root := `Main
  needs := #[consumerWeb]

@[default_target]
lean_exe «consumer-oracle» where
  root := `Oracle

@[default_target]
lean_exe «consumer-blog» where
  root := `BlogMain

@[default_target]
lean_exe «consumer-slides» where
  root := `SlidesMain
